<?xml version="1.0" encoding="UTF-8"?>
<project name="LibraryBookBorrowingSystem" default="jar" basedir=".">
    <property file="nbproject/project.properties"/>

    <path id="classpath">
        <pathelement location="${file.reference.flatlaf-3.6.2.jar}"/>
        <pathelement location="${file.reference.sqlite-jdbc-3.53.4.0.jar}"/>
        <pathelement location="${build.classes.dir}"/>
    </path>

    <target name="clean" description="Remove compiled output and distribution files.">
        <delete dir="${build.dir}" quiet="true"/>
        <delete dir="${dist.dir}" quiet="true"/>
    </target>

    <target name="-init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="-init" description="Compile all Java sources in the project root.">
        <javac srcdir="${src.dir}"
               destdir="${build.classes.dir}"
               release="${javac.source}"
               includeantruntime="false"
               encoding="UTF-8"
               excludes="build/**,dist/**,nbproject/**,test/**">
            <classpath refid="classpath"/>
        </javac>
        <copy todir="${build.classes.dir}">
            <fileset dir="${resources.dir}"/>
        </copy>
    </target>

    <target name="jar" depends="compile" description="Build the application JAR.">
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Class-Path" value="../lib/flatlaf-3.6.2.jar ../lib/sqlite-jdbc-3.53.4.0.jar"/>
                <attribute name="Enable-Native-Access" value="ALL-UNNAMED"/>
            </manifest>
        </jar>
    </target>

    <target name="run" depends="compile" description="Run the application from the project root.">
        <java classname="${main.class}" fork="true" failonerror="true">
            <classpath refid="classpath"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
        </java>
    </target>
</project>
